      'kNelson' => array('type' => 'varchar', 'length' => 255, 'description' => 'The index of this character in _The Modern Reader\'s Japanese-English Character Dictionary_ by Andrew Nathaniel Nelson, Rutland, Vermont: Charles E. Tuttle Company, 1974.'),
      'kOtherNumeric' => array('type' => 'float', 'description' => 'The numeric value for the character in certain unusual, specialized contexts.'),
      'kPhonetic' => array('type' => 'varchar', 'length' => 32, 'description' => 'The phonetic index for the character from _Ten Thousand Characters: An Analytic Dictionary_ by G. Hugh Casey, S.J. Hong Kong: Kelley and Walsh, 1980.'),
