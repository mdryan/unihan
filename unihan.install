/**
 * Implements hook_install().
 */
function unihan_install() {
  _unihan_populate_name_tables();
}

/**
 * Implements hook_uninstall().
 */
function unihan_uninstall() {
  variable_del('unihan_imported');
}

/**
 * Create the {unihan} table if missing and record existing imported data.
 */
function unihan_update_7000() {
  if (!db_table_exists('unihan')) {
    db_create_table('unihan', drupal_get_schema_unprocessed('unihan', 'unihan'));
    return t('Created the {unihan} table.');
  }
  if (db_query('SELECT 1 FROM {unihan} LIMIT 1')->fetchField()) {
    variable_set('unihan_imported', TRUE);
    return t('Existing Unihan data found; marked as imported.');
  }
}

/**
 * Add and populate the {unihan_surname} and {unihan_given} tables.
 */
function unihan_update_7001() {
  $name_table = [
    'fields' => [
      'name' => [
        'type' => 'varchar',
        'length' => 8,
        'not null' => TRUE,
        'description' => 'One or more Chinese characters.',
      ],
      'pinyin' => [
        'type' => 'varchar',
        'length' => 64,
        'not null' => TRUE,
        'description' => 'Space separated numbered pinyin, one syllable for each character, e.g. ou1 yang2.',
      ],
    ],
    'primary key' => ['name'],
  ];
  if (!db_table_exists('unihan_surname')) {
    db_create_table('unihan_surname', ['description' => 'Readings of Chinese characters used as family names, e.g. 曾 zeng1, including compound surnames such as 欧阳.'] + $name_table);
  }
  if (!db_table_exists('unihan_given')) {
    db_create_table('unihan_given', ['description' => 'Readings of Chinese characters used in given names, where they differ from the usual reading, e.g. 娜 na4.'] + $name_table);
  }
  $counts = _unihan_populate_name_tables();
  return t('Added @surnames surname readings and @given given name readings.', [
    '@surnames' => $counts['unihan_surname'],
    '@given' => $counts['unihan_given'],
  ]);
}

/**
 * Adds the default name readings, replacing any existing reading of a name.
 *
 * @return array
 *   The number of readings added to each table, keyed by table name.
 */
function _unihan_populate_name_tables() {
  $counts = [];
  foreach (_unihan_default_name_readings() as $table => $readings) {
    foreach ($readings as $name => $pinyin) {
      db_merge($table)
        ->key(['name' => $name])
        ->fields(['pinyin' => $pinyin])
        ->execute();
    }
    $counts[$table] = count($readings);
  }
  return $counts;
}

/**
 * Returns the default name readings.
