    'primary key' => ['name'],
  ];
  $schema['unihan_surname'] = ['description' => 'Readings of Chinese characters used as family names, e.g. 曾 zeng1, including compound surnames such as 欧阳.'] + $name_table;
  $schema['unihan_given'] = ['description' => 'Readings of Chinese characters used in given names, where they differ from the usual reading, e.g. 娜 na4.'] + $name_table;
  return $schema;
