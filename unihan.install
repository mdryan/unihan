<?php

/**
 * @file
 * Install, update and uninstall functions for the unihan module.
 */

/**
 * Implements hook_requirements().
 */
function unihan_requirements($phase) {
  $requirements = [];
  if ($phase != 'runtime') {
    return $requirements;
  }
  $t = get_t();
  module_load_include('inc', 'unihan', 'unihan.admin');
  $requirements['unihan']['title'] = $t('Unihan database');
  if (variable_get('unihan_imported', FALSE)) {
    $requirements['unihan']['value'] = $t('Imported');
    $requirements['unihan']['severity'] = REQUIREMENT_OK;
  }
  elseif (unihan_admin_get_filepath()) {
    $requirements['unihan']['value'] = $t('Awaiting import');
    $requirements['unihan']['description'] = $t('The Unihan database has not yet been imported. <a href="@url">Import it now</a>.', [
      '@url' => url('admin/config/regional/unihan/import'),
    ]);
    $requirements['unihan']['severity'] = REQUIREMENT_WARNING;
  }
  else {
    $requirements['unihan']['value'] = $t('Missing');
    $requirements['unihan']['description'] = $t('The <a href="@unihan">unihan.txt</a> file is missing. Place it in the <code>@directory</code> directory.', [
      '@unihan' => 'https://www.unicode.org/charts/unihan.html',
      '@directory' => 'sites/all/libraries/unihan',
    ]);
    $requirements['unihan']['severity'] = REQUIREMENT_ERROR;
  }
  return $requirements;
}

