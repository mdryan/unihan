      'kPhonetic' => ['type' => 'varchar', 'length' => 32, 'description' => 'The phonetic index for the character from _Ten Thousand Characters: An Analytic Dictionary_ by G. Hugh Casey, S.J. Hong Kong: Kelley and Walsh, 1980.'],
      'kPrimaryNumeric' => ['type' => 'float', 'description' => 'The value of the character when used in the writing of numbers in the standard fashion.'],
      'kPseudoGB1' => ['type' => 'float', 'description' => 'A "GB 12345-90" code point assigned this character for the purposes of including it within Unihan.'],
