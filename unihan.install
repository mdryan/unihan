<?php
// $Id$
/**
 *@file
 *Install file for unihan module
 *
 * gbcodes.txt is a tab seperated utf8 file
 *
 * gbcodes.txt contains data from the National Bureau of Statistics of China:
 * http://www.stats.gov.cn/tjbz/xzqhdm/t20021125_46781.htm
 *
 * Additional data for non commercial use (with traditional characters) is published
 * by the Consortium for International Earth Science Information Network:
 * http://sedac.ciesin.org/china/admin/gbcode/gbcode.html
 *
 */
function unihan_install() {
  drupal_install_schema('unihan');
  unihan_import_data();
}

function unihan_uninstall() {
  drupal_uninstall_schema('unihan');
}

function unihan_schema() {
  $schema['unihan'] = array(
    'fields' => array(
      'code' => array('type' => 'char', 'length' => 1, 'not null' => TRUE),
      'kCantonese' => array('type' => 'varchar', 'length' => 255),
      'kDefinition' => array('type' => 'text', 'length' => 2048),
      'kHanYu' => array('type' => 'float'),
      'kIRGHanyuDaZidian' => array('type' => 'float'),
      'kIRGKangXi' => array('type' => 'float'),
      'kIRG_GSource' => array('type' => 'int'),
      'kIRG_JSource' => array('type' => 'int'),
      'kIRG_TSource' => array('type' => 'int'),
      'kMandarin' => array('type' => 'varchar', 'length' => 255),
      'kRSUnicode' => array('type' => 'float'),
      'kSemanticVariant' => array('type' => 'varchar', 'length' => 255),
      'kTotalStrokes' => array('type' => 'float'),
      'kCihaiT' => array('type' => 'float'),
      'kIRG_KSource' => array('type' => 'int'),
      'kSBGY' => array('type' => 'float'),
      'kJIS0213' => array('type' => 'varchar', 'length' => 32),
      'kNelson' => array('type' => 'varchar', 'length' => 255),
      'kCowles' => array('type' => 'float'),
      'kMatthews' => array('type' => 'float'),
      'kPhonetic' => array('type' => 'varchar', 'length' => 32),
      'kIRG_KPSource' => array('type' => 'int'),
      'kIRG_VSource' => array('type' => 'int'),
      'kKPS1' => array('type' => 'int'),
      'kGSR' => array('type' => 'varchar', 'length' => 32),
      'kKarlgren' => array('type' => 'varchar', 'length' => 32),
      'kCangjie' => array('type' => 'varchar', 'length' => 32),
      'kHKSCS' => array('type' => 'varchar', 'length' => 32),
      'kIRG_HSource' => array('type' => 'int'),
      'kMeyerWempe' => array('type' => 'varchar', 'length' => 255),
      'kVietnamese' => array('type' => 'varchar', 'length' => 255),
      'kLau' => array('type' => 'varchar', 'length' => 255),
      'kFenn' => array('type' => 'varchar', 'length' => 32),
      'kZVariant' => array('type' => 'varchar', 'length' => 32),
      'kTraditionalVariant' => array('type' => 'varchar', 'length' => 255),
      'kJapaneseKun' => array('type' => 'varchar', 'length' => 255),
      'kJapaneseOn' => array('type' => 'varchar', 'length' => 255),
      'kKPS0' => array('type' => 'int'),
      'kTang' => array('type' => 'varchar', 'length' => 255),
      'kSimplifiedVariant' => array('type' => 'varchar', 'length' => 32),
      'kRSKangXi' => array('type' => 'float'),
      'kAlternateKangXi' => array('type' => 'float'),
      'kAlternateMorohashi' => array('type' => 'varchar', 'length' => 32),
      'kBigFive' => array('type' => 'int'),
      'kCCCII' => array('type' => 'int'),
      'kCNS1986' => array('type' => 'int'),
      'kCNS1992' => array('type' => 'int'),
      'kDaeJaweon' => array('type' => 'float'),
      'kEACC' => array('type' => 'int'),
      'kFrequency' => array('type' => 'float'),
      'kGB0' => array('type' => 'float'),
      'kGB1' => array('type' => 'float'),
      'kGradeLevel' => array('type' => 'float'),
      'kHKGlyph' => array('type' => 'float'),
      'kIRGDaeJaweon' => array('type' => 'float'),
      'kIRGDaiKanwaZiten' => array('type' => 'varchar', 'length' => 32),
      'kJis0' => array('type' => 'float'),
      'kKSC0' => array('type' => 'float'),
      'kKangXi' => array('type' => 'float'),
      'kKorean' => array('type' => 'varchar', 'length' => 255),
      'kMainlandTelegraph' => array('type' => 'float'),
      'kMorohashi' => array('type' => 'varchar', 'length' => 32),
      'kPrimaryNumeric' => array('type' => 'float'),
      'kSpecializedSemanticVariant' => array('type' => 'varchar', 'length' => 32),
      'kTaiwanTelegraph' => array('type' => 'float'),
      'kXerox' => array('type' => 'varchar', 'length' => 32),
      'kHanyuPinlu' => array('type' => 'varchar', 'length' => 255),
      'kGB5' => array('type' => 'float'),
      'kJis1' => array('type' => 'float'),
      'kPseudoGB1' => array('type' => 'float'),
      'kGB3' => array('type' => 'float'),
      'kGB8' => array('type' => 'float'),
      'kKSC1' => array('type' => 'float'),
      'kIBMJapan' => array('type' => 'int'),
      'kRSKanWa' => array('type' => 'float'),
      'kRSJapanese' => array('type' => 'float'),
      'kAccountingNumeric' => array('type' => 'float'),
      'kRSKorean' => array('type' => 'float'),
      'kOtherNumeric' => array('type' => 'float'),
      'kGB7' => array('type' => 'float'),
      'kCompatibilityVariant' => array('type' => 'varchar', 'length' => 32),
      'kIRG_USource' => array('type' => 'int'),
    ),
    'primary key' => array('code'),
    'indexes' => array('code' => array('code')),
  );
  return $schema;
}

function unihan_import_data() {
  ini_set('max_execution_time', 300); // extend maximum execution time to five minutes. Probably better would be to process file in batches...
  if (!$fh = fopen(drupal_get_path('module', 'unihan').'/unihan.txt', 'r')) {
    drupal_set_message(t('Unable to open unihan.txt, please check your installation and reinstall module.'));
    return;
  }
  fgets($fh);   // throw away first line (may have BOM)
  while (!feof($fh)) {
    $line = trim(fgets($fh));
    if ($line[0] == "#" || $line=="") {
        continue; // throw away comments or blank lines
    }
    list($code, $field, $data) = explode("\t", $line);
    $code = mb_convert_encoding('&#' . hexdec(substr($code, 2)) . ';' , 'UTF-8', 'HTML-ENTITIES');
    if (!$seen[$code]) {
      db_query("INSERT INTO {unihan} SET `code`='%s'", $code);
      $seen[$code] = TRUE;
    }
    if (in_array($field, array(
      'kBigFive', 'kCCCII', 'kCNS1986', 'kCNS1992', 'kEACC', 'kIBMJapan', 'kIRG_GSource',
      'kIRG_HSource', 'kIRG_JSource', 'kIRG_KSource', 'kIRG_KPSource', 'kIRG_TSource',
      'kIRG_USource', 'kIRG_VSource', 'kKPS0', 'kKPS1'))) {
      $data = hexdec($data);
    }
    if (!is_numeric($data)) {
      $data = "'" . db_escape_string($data) . "'";
    }
    db_query("UPDATE {unihan} SET `$field`=$data WHERE `code`='%s'", $code);  //It's *probably* OK to use $data as a variable not a placeholder here. Real problem is quoting (or not) string (or int or float) variables.
  }
}
